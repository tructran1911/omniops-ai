# TODO(setup): copy this file to .env.local and fill in the values (README → Setup on Google Cloud, step 6).
#   PowerShell:  Copy-Item .env.example .env.local
# .env.local is used when running locally against a real Google Cloud project (npm run dev, npm run seed,
# npm run try:pipeline, npm run benchmark). Do NOT commit .env.local (it is already in .gitignore).
# On Cloud Run these variables are set by scripts/deploy.ps1.

# Gemini Developer API key – get one at https://aistudio.google.com → Get API key. This is a SECRET.
GEMINI_API_KEY=

# TODO(setup): the model name confirmed in AI Studio (model list, free tier section). Code default: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# TODO(setup): the Google Cloud Project ID (NOT the project number), e.g. omniops-ai-471203
GOOGLE_CLOUD_PROJECT=

# TODO(setup): the Cloud Storage bucket created in README → Setup, step 3; defaults to <PROJECT_ID>-docs
GCS_BUCKET=

# Optional: use Gemini on Vertex AI instead of the Developer API (needs aiplatform.googleapis.com; billed per token)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional: maximum analyses per user per hour (default 10)
# RATE_LIMIT_PER_HOUR=10
